<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Workspace storage. The app keeps notes as ordinary .md files in a
         folder the user picks, and scans that folder with std::fs from Rust —
         real paths, not content:// URIs. On Android 11+ that is precisely what
         scoped storage withholds without All files access, so the app asks for
         it; the user grants it on a Settings screen, and until they do the
         workspace stays in the app's own storage, which needs no permission at
         all. Below 11 the ordinary read/write permission covers the same
         ground, so it is declared with maxSdkVersion rather than requested
         everywhere.

         This rules out a Play Store listing without a declared exemption. The
         app is distributed as an APK. -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="29" />

    <!-- The one buzz in the app: the moment a long press on a note becomes a
         drag (lib/touchDrag.ts). Without this the WebView refuses the call —
         "Failed to use vibrate API, requires VIBRATE permission" — and the lift
         is silent, which is most of why the gesture read as not working: there
         was nothing to tell you the press had been taken. Not a runtime
         permission; declaring it is granting it. -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.valx_prose_writer"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode|fontScale"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
